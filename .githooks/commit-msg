#!/bin/sh

# Enforce Conventional Commits (https://www.conventionalcommits.org).
# Runs on every `git commit`; the message is in the file passed as $1.

commit_msg_file="$1"

# Read the first non-comment, non-blank line — that's the subject.
subject=$(grep -v '^#' "$commit_msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)

# Skip auto-generated messages that aren't user-authored:
#   - merge commits        ("Merge ...")
#   - revert commits       ("Revert \"...\"")
#   - fixup / squash       ("fixup! ..." / "squash! ...")
case "$subject" in
    "Merge "*|"Revert \""*|"fixup! "*|"squash! "*)
        exit 0
        ;;
esac

# Conventional Commit subject:
#   <type>(<optional scope>)!?: <description>
# Types follow the Angular convention used by commitlint's @commitlint/config-conventional.
pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .+'

if printf '%s' "$subject" | grep -Eq "$pattern"; then
    exit 0
fi

cat >&2 <<'EOF'
Commit rejected: subject line is not a Conventional Commit.

Expected:
  <type>[optional scope][!]: <description>

Where <type> is one of:
  build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test

Examples:
  feat(rsa): add batch membership proof
  fix: correct off-by-one in non-mem witness update
  docs(readme): document docs.rs metadata block
  refactor!: rename PrivatelyDelegatableAccumulator trait

See https://www.conventionalcommits.org for the full spec.
EOF

exit 1
